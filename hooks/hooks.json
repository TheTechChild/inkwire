{
  "hooks": {
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/forward.sh", "timeout": 10 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__(plugin_inkwire_)?inkwire__session_mode",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/forward.sh", "timeout": 10 }]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/forward.sh", "timeout": 10 }]
      }
    ]
  }
}
