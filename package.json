{
  "name": "inkwire",
  "version": "0.1.0",
  "description": "Local MCP server + shared drawing canvas for collaborating visually with an AI agent on a codebase.",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=26"
  },
  "bin": "dist/server/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node esbuild.ui.mjs",
    "dev": "node esbuild.ui.mjs --watch & tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:schemas": "tsx src/scripts/gen-schemas.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^13.0.3",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.5.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
