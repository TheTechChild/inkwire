{
  "name": "inkwire",
  "version": "0.1.0",
  "description": "Local MCP server + shared drawing canvas for collaborating visually with an AI agent on a codebase.",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=26"
  },
  "bin": "dist/server/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node esbuild.ui.mjs && node scripts/write-build-id.mjs",
    "dev": "INKWIRE_PORT=4692 INKWIRE_DATA_DIR=$HOME/.inkwire-dev INKWIRE_IDLE_GRACE_MS=off node esbuild.ui.mjs --watch & INKWIRE_PORT=4692 INKWIRE_DATA_DIR=$HOME/.inkwire-dev INKWIRE_IDLE_GRACE_MS=off tsx watch src/server/daemon.ts",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "gen:schemas": "tsx src/scripts/gen-schemas.ts",
    "map-anchors": "node scripts/map-anchor-check.mjs --all",
    "map-anchors:test": "node --test scripts/map-anchor-check.test.mjs",
    "build-id:test": "node --test scripts/write-build-id.test.mjs",
    "daemon:restart": "node scripts/daemon-restart.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^13.0.3",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.5.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.0",
    "fast-check": "^4.9.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
